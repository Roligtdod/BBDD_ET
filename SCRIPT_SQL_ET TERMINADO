START WITH 703
INCREMENT BY 4
NOCACHE
NOCYCLE;

CREATE OR REPLACE TRIGGER id_club_tg
BEFORE INSERT ON club
FOR EACH ROW
  WHEN (new. id_club IS NULL)
BEGIN
  :new.id_club := id_club_sq.NEXTVAL;
END;
/





