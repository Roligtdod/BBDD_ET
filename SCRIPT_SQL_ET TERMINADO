
CREATE TABLE ASOCIACION 
    ( 
     id_asociacion     NUMBER  NOT NULL , 
     nombre_asociacion VARCHAR2 (40)  NOT NULL , 
     fecha_creacion DATE NOT NULL CHECK (fecha_creacion >= DATE '1980-12-31'),
     tipo              CHAR (1)  NOT NULL 
    ) 
;

ALTER TABLE ASOCIACION 
    ADD CONSTRAINT ASOCIACION_PK PRIMARY KEY ( id_asociacion ) ;

CREATE TABLE CLUB 
    ( 
     id_club     NUMBER  NOT NULL , 
     nombre_club VARCHAR2 (20)  NOT NULL,
     patrimonio  NUMBER  NOT NULL , 
     id_comuna NUMBER NOT NULL,
     id_region NUMBER NOT NULL,
     direccion   VARCHAR2 (40)  NOT NULL,
     tipo VARCHAR2(20) NOT NULL
    ) 
;

ALTER TABLE CLUB 
    ADD CONSTRAINT CLUB_PK PRIMARY KEY ( id_club ) ;

CREATE TABLE COMUNA 
    ( 
     id_comuna        NUMBER  NOT NULL , 
     nombre_comuna    VARCHAR2 (30)  NOT NULL , 
     REGION_id_region NUMBER  NOT NULL 
    ) 
;

ALTER TABLE COMUNA 
    ADD CONSTRAINT COMUNA_PK PRIMARY KEY ( id_comuna ) ;

CREATE TABLE ESCUELA_FUTBOL 
    ( 
     id_escuela      NUMBER  NOT NULL , 
     nombre_escuela  VARCHAR2 (20)  NOT NULL , 
     capacidad       NUMBER  NOT NULL , 
     fecha_fundacion DATE  NOT NULL 
    ) 
;

ALTER TABLE ESCUELA_FUTBOL 
    ADD CONSTRAINT ESCUELA_FUTBOL_PK PRIMARY KEY ( id_escuela ) ;

CREATE TABLE IDIOMA 
    ( 
     id_idioma     NUMBER  NOT NULL , 
     nombre_idioma VARCHAR2 (20)  NOT NULL 
    ) 
;

ALTER TABLE IDIOMA 
    ADD CONSTRAINT IDIOMA_PK PRIMARY KEY ( id_idioma ) ;

CREATE TABLE JUGADOR 
    ( 
     id_colaborador               NUMBER  NOT NULL , 
     posicion                     VARCHAR2 (12)  NOT NULL , 
     cant_premios                 NUMBER  NOT NULL , 
     ESCUELA_FUTBOL_id_escuela    NUMBER  NOT NULL , 
     ASOCIACION_id_asociacion     NUMBER  NOT NULL , 
     NACIONALIDAD_id_nacionalidad NUMBER  NOT NULL 
    ) 
;

ALTER TABLE JUGADOR 
    ADD CONSTRAINT JUGADOR_PK PRIMARY KEY ( id_colaborador ) ;

CREATE TABLE JUGADOR_PERMANENCIA 
    ( 
     fecha_inicio           DATE  NOT NULL , 
     fecha_termino          DATE  NOT NULL , 
     CLUB_id_club           NUMBER  NOT NULL , 
     JUGADOR_id_colaborador NUMBER  NOT NULL 
    ) 
;

ALTER TABLE JUGADOR_PERMANENCIA 
    ADD CONSTRAINT JUGADOR_PERMANENCIA_PK PRIMARY KEY ( fecha_inicio, JUGADOR_id_colaborador ) ;

CREATE TABLE NACIONALIDAD 
    ( 
     id_nacionalidad NUMBER GENERATED ALWAYS AS IDENTITY START WITH 2 INCREMENT BY 2 NOT NULL  ,
     nacionalidad    VARCHAR2 (20)  NOT NULL 
    ) 
;

ALTER TABLE NACIONALIDAD 
    ADD CONSTRAINT NACIONALIDAD_PK PRIMARY KEY ( id_nacionalidad ) ;

CREATE TABLE NIVEL_IDIOMA 
    ( 
     nivel_idioma           VARCHAR2 (20)  NOT NULL , 
     id_nivel               NUMBER  NOT NULL , 
     IDIOMA_id_idioma       NUMBER  NOT NULL , 
     JUGADOR_id_colaborador NUMBER  NOT NULL 
    ) 
;

ALTER TABLE NIVEL_IDIOMA 
    ADD CONSTRAINT NIVEL_IDIOMA_PK PRIMARY KEY ( id_nivel, IDIOMA_id_idioma, JUGADOR_id_colaborador ) ;

CREATE TABLE PERSONAL_PLANTA 
    ( 
     id_colaborador NUMBER  NOT NULL , 
     cant_hrs       NUMBER  NOT NULL , 
     hrs_extras     NUMBER 
    ) 
;

ALTER TABLE PERSONAL_PLANTA 
    ADD CONSTRAINT PERSONAL_PLANTA_PK PRIMARY KEY ( id_colaborador ) ;

CREATE TABLE REGION 
    ( 
     id_region     NUMBER  NOT NULL , 
     nombre_region VARCHAR2 (30)  NOT NULL 
    ) 
;

ALTER TABLE REGION 
    ADD CONSTRAINT REGION_PK PRIMARY KEY ( id_region ) ;

CREATE TABLE TRABAJADOR 
    ( 
