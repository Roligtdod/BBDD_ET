     dv               CHAR (1)  NOT NULL , 
     nombre           VARCHAR2 (15)  NOT NULL , 
     apellido         VARCHAR2 (15)  NOT NULL , 
     sueldo           NUMBER  NOT NULL , 
     fecha_nac        DATE  NOT NULL , 
